<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Lucid does not track, does not collect anything, and has no network code.
	  The one required-reason API it uses is UserDefaults, for a single flag
	  recording that the disclosure has been read.

	  Calibration profiles are written to the app's own Application Support
	  directory. That is not a collected data type: it never leaves the device
	  and is not linked to anyone.
	-->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: read and write information accessible only to this
				     app. Lucid stores one boolean and reads it back. -->
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
